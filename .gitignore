# Rust build artifacts
/target/
debug/
release/
**/*.rs.bk

# Local env files — the *.example templates carry no real values and ARE committed
.env*
!.env.example
!.env.compose.example
# ...and the backups setup.sh takes before overwriting
*.bak.*

# Local dev TLS certs — regenerate via scripts/k3d-setup.sh
.local-tls/

# IDE and editor specific
.idea/
.vscode/
*.swp
*.swo
*~

# Agent scratch
/.claude/

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
