# Template for `.env.compose` — the environment for containers started by
# docker-compose (currently just the one-shot `migrate` service). Service names
# rather than localhost; otherwise it mirrors .env.example.
#
#   ./setup.sh          # generates it with a fresh AES_MASTER_KEY
#   cp .env.compose.example .env.compose

DATABASE_URL=postgres://admin:password@postgres:5432/knox
REDIS_URL=redis://redis:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889

# Generate with: openssl rand -base64 32
AES_MASTER_KEY=REPLACE_ME

KNOX_SCHEME=http
KNOX_BASE_DOMAIN=lvh.me
KNOX_PUBLIC_PORT=3000

HOST=0.0.0.0
PORT=8080

KNOX_LOG=info
ALLOW_ALL_ORIGINS=true

# Argon2 params — deliberately lowered so local runs and load tests are quick.
# Anything real wants at least m=19456, t=2, p=1 (OWASP minimum), which is what
# k8s/base/configmap.yaml sets.
ARGON2_M_COST=4096
ARGON2_T_COST=1
ARGON2_P_COST=1

# Connection pool tuning — match to your container resource limits
MAX_CONNECTIONS=20
MIN_CONNECTIONS=2
ACQUIRE_TIMEOUT=5
IDLE_TIMEOUT=300
MAX_LIFETIME=1800
