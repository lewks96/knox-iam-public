# Template for `.env` — the server running on the host (`cargo run -p server`)
# against the Postgres and Redis from docker-compose.
#
#   ./setup.sh          # generates .env, .env.compose and ui/.env.local
#   cp .env.example .env && openssl rand -base64 32   # or do it by hand
#
# `.env*` is gitignored apart from the *.example templates — never commit a
# filled-in copy.

DATABASE_URL=postgres://admin:password@localhost:5432/knox
REDIS_URL=redis://localhost:6379

# Wraps every tenant's RSA signing key at rest. Generate with:
#   openssl rand -base64 32
# Changing it after tenants exist orphans their keys.
AES_MASTER_KEY=REPLACE_ME

# lvh.me resolves *.lvh.me to 127.0.0.1, so tenant subdomains work locally
# without touching /etc/hosts. Issuers are per-tenant and stored on
# tenants.issuer; these three only mint the issuer for NEW tenants.
KNOX_SCHEME=http
KNOX_BASE_DOMAIN=lvh.me
KNOX_PUBLIC_PORT=3000

# lvh.me subdomains resolve to IPv4 127.0.0.1, so bind IPv4 not ::1
HOST=127.0.0.1
PORT=8080

RUST_LOG=error
KNOX_LOG=debug

ALLOW_ALL_ORIGINS=false
CORS_ORIGINS=http://localhost:3000

# Optional: an OTLP collector. Nothing breaks if there is nothing listening.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Local dev only. Next's rewrite proxy overwrites Host with the destination, so
# the tenant subdomain arrives in X-Forwarded-Host instead. In a cluster nginx
# preserves Host, so this MUST stay false there — trusting it would let a caller
# choose which tenant they resolve as.
KNOX_TRUST_FORWARDED_HOST=true
