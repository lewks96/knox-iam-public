  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id, tenant_id, kid, use_type, kty, alg,\n                public_key_pem, x509_cert_pem, encrypted_private_key,\n                state as \"state: KeyState\",\n                created_at, expires_at\n            FROM tenant_keys\n            WHERE tenant_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
