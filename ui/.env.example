# Template for ui/.env.local — copy it, or run ./setup.sh from the repo root.
#
# The values below are the local-dev defaults and match what `cargo run -p
# bootstrap` creates. The client id and tenant id are slugs here, not UUIDs:
# the API accepts either.

# "/api" keeps the browser on one origin and lets next.config.ts proxy through
# to the server, so the SSO cookie stays first-party.
NEXT_PUBLIC_API_BASE_URL=/api

NEXT_PUBLIC_MANAGEMENT_CLIENT_ID=management
NEXT_PUBLIC_MANAGEMENT_TENANT_ID=knox-root

# Must match KNOX_BASE_DOMAIN in the server's .env — the UI derives the tenant
# from its own hostname.
NEXT_PUBLIC_BASE_DOMAIN=lvh.me

# Where next.config.ts sends the proxied /api, /oauth2 and /.well-known calls.
# Defaults to http://127.0.0.1:8080 when unset.
# KNOX_API_ORIGIN=http://127.0.0.1:8080
